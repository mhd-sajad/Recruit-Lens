# Application Configuration
ENVIRONMENT=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Storage & Paths (Resolved relative to project root)
DATA_DIR=data
DATABASE_URL=sqlite+aiosqlite:///data/recruit_lens.db

# LLM Providers (Free Tier / Self-Hosted)
# Groq free tier API key placeholder
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Performance & Concurrency Limits
MAX_BATCH_RESUMES=200
MAX_UPLOAD_FILE_SIZE_MB=10
